SECRET_KEY=change-this-to-a-long-random-string
DATABASE_URL=sqlite:///medicore.db
# For PostgreSQL in production:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/medicore

# --- Optional: real SMS/WhatsApp notifications via Twilio ---
# Leave blank to just log messages instead of sending them (fine for local development).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# --- Optional: real email notifications via SMTP ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
